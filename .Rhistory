library(ggplot2)
# Si 'ingresos' es un vector numérico:
ggplot(data.frame(ingresos), aes(x = ingresos)) +
geom_histogram(bins = 6, fill = "steelblue", color = "black") +
labs(
title = "Distribución de los ingresos mensuales",
x = "Ingresos (millones de pesos)",
y = "Frecuencia"
) +
theme_minimal()
